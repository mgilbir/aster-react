{
  "name": "aster",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "pnpm --filter @aster/conformance run conformance",
    "probe": "pnpm --filter @aster/conformance run probe",
    "bench": "pnpm --filter @aster/benchmarks run bench",
    "bench:runtime": "pnpm --filter @aster/benchmarks run bench:runtime",
    "bench:memory": "pnpm --filter @aster/benchmarks run bench:memory",
    "bench:bundle": "pnpm --filter @aster/benchmarks run bench:bundle",
    "bench:browser": "pnpm --filter @aster/benchmarks run bench:browser",
    "check:deps": "node scripts/check-deps.mjs",
    "vectors": "pnpm --filter @aster/conformance run vectors",
    "check": "pnpm check:deps && pnpm typecheck && pnpm build && pnpm test && pnpm conformance && pnpm --filter @aster/benchmarks run budget",
    "conformance-vl": "pnpm --filter @aster/conformance run conformance-vl",
    "conformance:browser": "pnpm --filter @aster/conformance run conformance:browser"
  },
  "devDependencies": {
    "esbuild": "~0.25.12",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
