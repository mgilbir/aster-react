{
  "name": "aster",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "node scripts/test-tz.mjs",
    "conformance": "pnpm --filter @aster/conformance run conformance",
    "probe": "pnpm --filter @aster/conformance run probe",
    "bench": "pnpm --filter @aster/benchmarks run bench",
    "bench:runtime": "pnpm --filter @aster/benchmarks run bench:runtime",
    "bench:incremental": "pnpm --filter @aster/benchmarks run bench:incremental",
    "bench:differential": "pnpm --filter @aster/benchmarks run bench:differential",
    "bench:pipeline": "pnpm --filter @aster/benchmarks run bench:pipeline",
    "bench:memory": "pnpm --filter @aster/benchmarks run bench:memory",
    "bench:bundle": "pnpm --filter @aster/benchmarks run bench:bundle",
    "bench:browser": "pnpm --filter @aster/benchmarks run bench:browser",
    "bench:browser-stream": "pnpm --filter @aster/benchmarks run bench:browser-stream",
    "check:deps": "node scripts/check-deps.mjs",
    "check:bundle": "node scripts/check-bundle-shaking.mjs",
    "vectors": "pnpm --filter @aster/conformance run vectors",
    "check": "node scripts/gates.mjs",
    "conformance-vl": "pnpm --filter @aster/conformance run conformance-vl",
    "conformance:browser": "pnpm --filter @aster/conformance run conformance:browser",
    "conformance:canvas": "pnpm --filter @aster/conformance run conformance:canvas",
    "fuzz": "pnpm --filter @aster/conformance run fuzz",
    "fuzz:replay": "pnpm --filter @aster/conformance run fuzz:replay",
    "sweep-vl": "pnpm --filter @aster/conformance run sweep-vl",
    "sweep-vega": "pnpm --filter @aster/conformance run sweep-vega",
    "sweep-signals": "pnpm --filter @aster/conformance run sweep-signals",
    "scene-diff": "pnpm --filter @aster/conformance run scene-diff",
    "transform-matrix": "pnpm --filter @aster/conformance run transform-matrix",
    "a11y-parity": "pnpm --filter @aster/conformance run a11y-parity",
    "conformance:batch": "pnpm --filter @aster/conformance run conformance:batch",
    "conformance:signals": "pnpm --filter @aster/conformance run conformance:signals",
    "verify:publish": "node scripts/verify-publish.mjs"
  },
  "devDependencies": {
    "esbuild": "~0.25.12",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
