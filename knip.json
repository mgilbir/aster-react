{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/lib/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "packages/core": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/*.testlib.ts",
        "src/**/*.testkit.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/vl": {
      "entry": [
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/react": {
      "entry": [
        "src/parity.assert.ts",
        "src/**/*.test.{ts,tsx}",
        "type-fixtures/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/conformance": {
      "entry": [
        "src/**/*.{ts,tsx,mts,mjs}",
        "scripts/**/*.{ts,mts,mjs}",
        "test/**/*.{ts,mts}",
        "test-fixtures/**/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx,mts,mjs}",
        "scripts/**/*.{ts,mts,mjs}",
        "test/**/*.{ts,mts}"
      ]
    },
    "packages/benchmarks": {
      "entry": [
        "src/**/*.bench.{ts,tsx}",
        "src/*-entry.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "scripts/**/*.{mjs,mts}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,mts}"
      ]
    },
    "apps/demo": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "wrangler"
      ]
    }
  },
  "rules": {
    "duplicates": "warn"
  },
  "ignoreDependencies": [
    "react-dom",
    "vega-datasets",
    "vega-embed",
    "vega-functions",
    "vega-util"
  ]
}
