{
  "name": "@aster/react",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./worker-entry": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aster/core": "workspace:*",
    "@aster/vl": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "react": "^19.0.0"
  },
  "description": "React bindings for Aster Charts: <Chart>, useChart, interaction and accessibility.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgilbir/aster-react.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/mgilbir/aster-react#readme",
  "bugs": {
    "url": "https://github.com/mgilbir/aster-react/issues"
  },
  "keywords": "react, vega, vega-lite, charts, dataviz, accessibility",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
