{
  "name": "@aster-charts/core",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addons": {
      "types": "./dist/addons.d.ts",
      "default": "./dist/addons.js"
    },
    "./geo": {
      "types": "./dist/addon-geo.d.ts",
      "default": "./dist/addon-geo.js"
    },
    "./transforms": {
      "types": "./dist/addon-transforms.d.ts",
      "default": "./dist/addon-transforms.js"
    },
    "./dom": {
      "types": "./dist/addon-dom.d.ts",
      "default": "./dist/addon-dom.js"
    },
    "./load": {
      "types": "./dist/addon-load.d.ts",
      "default": "./dist/addon-load.js"
    },
    "./signals": {
      "types": "./dist/entry-signals.d.ts",
      "default": "./dist/entry-signals.js"
    },
    "./canvas": {
      "types": "./dist/entry-canvas.d.ts",
      "default": "./dist/entry-canvas.js"
    },
    "./hit": {
      "types": "./dist/entry-hit.d.ts",
      "default": "./dist/entry-hit.js"
    },
    "./transition": {
      "types": "./dist/transition.d.ts",
      "default": "./dist/transition.js"
    },
    "./png": {
      "types": "./dist/entry-png.d.ts",
      "default": "./dist/entry-png.js"
    },
    "./lean": {
      "types": "./dist/lean.d.ts",
      "browser": "./dist/lean.js",
      "default": "./dist/lean-full.js"
    },
    "./lean/hit": {
      "types": "./dist/hit.d.ts",
      "browser": "./dist/hit.js",
      "default": "./dist/entry-hit.js"
    },
    "./lean/signals": {
      "types": "./dist/signals-deferred.d.ts",
      "browser": "./dist/signals-deferred.js",
      "default": "./dist/lean-signals-full.js"
    },
    "./lean/canvas": {
      "types": "./dist/canvas-deferred.d.ts",
      "browser": "./dist/canvas-deferred.js",
      "default": "./dist/part-canvas.js"
    },
    "./lean/stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    },
    "./lean/all": {
      "types": "./dist/lean-all.d.ts",
      "default": "./dist/lean-all.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/guide-caption.js",
    "./dist/label.js",
    "./dist/addon-geo.js",
    "./dist/addon-load.js",
    "./dist/addon-transforms.js",
    "./dist/stats-functions.js",
    "./dist/transform-extra.js",
    "./dist/index.js",
    "./dist/addon-dom.js",
    "./dist/entry-signals.js",
    "./dist/entry-hit.js",
    "./dist/entry-canvas.js",
    "./dist/entry-png.js",
    "./dist/lean-full.js",
    "./dist/parts-evaluate.js",
    "./dist/parts-signals.js",
    "./dist/parts-all.js",
    "./dist/part-aggregate.js",
    "./dist/part-window.js",
    "./dist/part-reshape.js",
    "./dist/part-time.js",
    "./dist/part-curves.js",
    "./dist/part-color.js",
    "./dist/part-scales.js",
    "./dist/part-legend.js",
    "./dist/part-layout.js",
    "./dist/part-pulse.js",
    "./dist/part-selections.js",
    "./dist/part-regex.js",
    "./dist/part-svgpath.js",
    "./dist/part-intersect.js",
    "./dist/part-modify.js",
    "./dist/part-timer.js",
    "./dist/part-canvas.js",
    "./dist/part-signals.js",
    "./dist/lean-signals-full.js",
    "./dist/lean-all.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.8.0"
  },
  "description": "A small TypeScript Vega/Vega-Lite rendering engine on owned D3 primitives.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgilbir/aster-react.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mgilbir/aster-react#readme",
  "bugs": {
    "url": "https://github.com/mgilbir/aster-react/issues"
  },
  "keywords": [
    "vega",
    "vega-lite",
    "charts",
    "dataviz",
    "svg",
    "d3"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
