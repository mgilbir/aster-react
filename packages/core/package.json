{
  "name": "@aster/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geo": {
      "types": "./dist/addon-geo.d.ts",
      "import": "./dist/addon-geo.js"
    },
    "./transforms": {
      "types": "./dist/addon-transforms.d.ts",
      "default": "./dist/addon-transforms.js"
    },
    "./dom": {
      "types": "./dist/addon-dom.d.ts",
      "default": "./dist/addon-dom.js"
    },
    "./load": {
      "types": "./dist/addon-load.d.ts",
      "default": "./dist/addon-load.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "default": "./dist/canvas.js"
    },
    "./hit": {
      "types": "./dist/hit.d.ts",
      "default": "./dist/hit.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.0",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "@types/node": "^22.20.1"
  }
}
