{
  "name": "@aster/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addons": {
      "types": "./dist/addons.d.ts",
      "default": "./dist/addons.js"
    },
    "./geo": {
      "types": "./dist/addon-geo.d.ts",
      "default": "./dist/addon-geo.js"
    },
    "./transforms": {
      "types": "./dist/addon-transforms.d.ts",
      "default": "./dist/addon-transforms.js"
    },
    "./dom": {
      "types": "./dist/addon-dom.d.ts",
      "default": "./dist/addon-dom.js"
    },
    "./load": {
      "types": "./dist/addon-load.d.ts",
      "default": "./dist/addon-load.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "default": "./dist/canvas.js"
    },
    "./hit": {
      "types": "./dist/hit.d.ts",
      "default": "./dist/hit.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/guide-caption.js",
    "./dist/addon-geo.js",
    "./dist/addon-load.js",
    "./dist/addon-transforms.js",
    "./dist/stats-functions.js",
    "./dist/transform-extra.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.0",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "@types/node": "^22.20.1"
  },
  "description": "A small TypeScript Vega/Vega-Lite rendering engine on owned D3 primitives.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgilbir/aster-react.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mgilbir/aster-react#readme",
  "bugs": {
    "url": "https://github.com/mgilbir/aster-react/issues"
  },
  "keywords": [
    "vega",
    "vega-lite",
    "charts",
    "dataviz",
    "svg",
    "d3"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
