{
  "name": "@aster/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geo": {
      "types": "./dist/addon-geo.d.ts",
      "import": "./dist/addon-geo.js"
    },
    "./transforms": {
      "types": "./dist/addon-transforms.d.ts",
      "default": "./dist/addon-transforms.js"
    },
    "./dom": {
      "types": "./dist/addon-dom.d.ts",
      "default": "./dist/addon-dom.js"
    },
    "./load": {
      "types": "./dist/addon-load.d.ts",
      "default": "./dist/addon-load.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "default": "./dist/signals.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2",
    "d3-format": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "vega-scale": "^8.1.2"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "typescript": "^5.8.0",
    "vega": "^6.3.1",
    "vega-lite": "^6.4.3",
    "@types/node": "^22.20.1"
  }
}
