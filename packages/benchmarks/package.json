{
  "name": "@aster/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "budget": "node scripts/budget.mjs",
    "bench:bundle": "tsx scripts/bundle-size.mjs",
    "bench:runtime": "tsx src/runtime.bench.tsx",
    "bench:differential": "tsx src/differential.bench.tsx",
    "bench:memory": "node --expose-gc --import tsx src/memory.bench.tsx",
    "bench:browser": "tsx scripts/browser.bench.mjs",
    "bench:pipeline": "tsx src/pipeline.bench.tsx",
    "bench": "pnpm bench:runtime && pnpm bench:incremental && pnpm bench:browser-stream && pnpm bench:differential && pnpm bench:memory && pnpm bench:bundle && pnpm bench:browser",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:incremental": "tsx src/incremental.bench.tsx",
    "bench:browser-stream": "tsx scripts/browser-stream.bench.mjs"
  },
  "dependencies": {
    "@aster/core": "workspace:*",
    "@aster/react": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-vega": "^8.0.0",
    "tsx": "^4.23.4",
    "vega": "^6.3.1",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  }
}
