{
  "name": "@aster/conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "conformance": "tsx src/run.ts",
    "conformance:diff": "tsx src/diff.ts",
    "probe": "tsx src/probe.ts",
    "vectors": "node scripts/gen-vectors.mjs",
    "conformance-vl": "tsx src/run-vl.ts",
    "sweep-vega": "tsx src/run-sweep.ts vega-schema",
    "sweep-vl": "tsx src/run-sweep.ts vega-lite-schema",
    "sweep-values": "tsx src/run-sweep.ts values",
    "sweep-signals": "tsx src/run-sweep.ts signals",
    "conformance:browser": "tsx scripts/browser-conformance.mts",
    "fuzz": "tsx scripts/fuzz.mts",
    "fuzz:replay": "tsx scripts/fuzz.mts --replay",
    "scene-diff": "tsx scripts/scene-diff.mts",
    "transform-matrix": "tsx scripts/transform-matrix.mts",
    "a11y-parity": "tsx scripts/a11y-parity.mts",
    "conformance:canvas": "tsx scripts/browser-canvas-parity.mts",
    "conformance:batch": "tsx scripts/browser-svg-batch-parity.mts"
  },
  "dependencies": {
    "@aster/core": "workspace:*",
    "@aster/vl": "workspace:*",
