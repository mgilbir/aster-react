    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "d3-array": "3.2.4",
    "d3-color": "3.1.0",
    "d3-contour": "4.0.2",
    "d3-dsv": "3.0.1",
    "d3-format": "3.1.2",
    "d3-geo": "3.1.1",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-time-format": "4.1.0",
    "playwright": "^1.62.1",
    "topojson-client": "3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vega-embed": "^7.1.0",
    "vega-expression": "6.2.1",
    "vega-format": "2.1.2",
    "vega-functions": "6.1.3",
    "vega-interpreter": "2.3.1",
    "vega-scale": "8.1.2",
    "vega-time": "3.2.1",
    "vega-util": "2.1.2"
  }
