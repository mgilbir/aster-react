{
 "$schema": "https://vega.github.io/schema/vega/v6.json",
 "width": 400,
 "height": 200,
 "padding": 5,
 "autosize": "none",
 "background": "white",
 "scales": [
  {
   "name": "x",
   "type": "time",
   "domain": [
    0,
    21600000
   ],
   "range": "width"
  },
  {
   "name": "y",
   "type": "linear",
   "domain": [
    0,
    10
   ],
   "range": "height"
  }
 ],
 "axes": [
  {
   "scale": "x",
   "orient": "bottom"
  }
 ]
}
