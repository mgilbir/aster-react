{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "padding": 5,
  "autosize": "none",
  "width": 300,
  "height": 200,
  "data": {
    "name": "flat",
    "values": [
      {
        "a.b": 1,
        "c d": 2,
        "e[f]": 3
      },
      {
        "a.b": 2,
        "c d": 5,
        "e[f]": 1
      }
    ]
  },
  "mark": "point",
  "encoding": {
    "x": {
      "field": "a\\.b",
      "type": "quantitative"
    },
    "y": {
      "field": "c d",
      "type": "quantitative"
    },
    "size": {
      "field": "e\\[f\\]",
      "type": "quantitative"
    }
  }
}
