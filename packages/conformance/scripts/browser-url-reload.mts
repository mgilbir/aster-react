/**
 * Real-browser differential for url data that follows a signal changed INSIDE the chart.
 *
 * vega reloads a dataset whose `url` is a `{signal}` whenever a signal the url reads changes, wherever the change comes from: a
 * bound input, an event handler, a signal derived from another. `<Chart urlLoad>` must do the same. Each case is a Vega spec whose
 * data lives on a small HTTP server of this script (CORS open: the pages are file:// pages), mounted twice in headless Chromium:
 * in a real vega `View` (its own loader, its bound inputs generated by vega-view) and in `<Chart urlLoad={{ baseURL }}>` (its
 * bound inputs, its event loop, the chart's own loader under the host's URL policy). The SAME native input -- Playwright
 * select / radio / range / click -- is driven through both, and after every step, once both have gone quiet, the two must agree on
 *
 *   - the rendered SVG (the strict canonicalizer of the conformance gates), i.e. the rows drawn, and
 *   - the requests the server saw, in order (a reload per changed url; none for a signal the url does not read).
 *
 * A case that can never differ proves nothing, so each states the steps after which the vega side must have drawn something
 * other than before (`moves`): a vacuous case fails.
 *
 * Where Aster differs from vega on purpose, the case says so in `aster` and the gate checks what it does instead (a load that a
 * newer url supersedes is aborted: vega lets its request finish).
 *
 * The verdict is runGate's (scripts/lib/run-gate.mjs): `compared` counts the cases compared, with a floor. `--plant-difference`
 * adds an element to the SVG Aster reports at every step.
 *
 * Run: pnpm conformance:url-reload [--filter=substr]   (after `pnpm build`)
 */
import { writeFileSync, rmSync, mkdirSync } from 'node:fs'
import { createServer } from 'node:http'
import type { AddressInfo } from 'node:net'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { build } from 'esbuild'
import type { Page } from 'playwright'
import { canonicalizeSvg, diffCanonical } from '../src/normalize.js'
import { cli } from '../../../scripts/lib/cli.mjs'
import { makeTempDir } from '../../../scripts/lib/temp-dir.mjs'
import { GATE_FLAGS, runGate, type Gate } from '../../../scripts/lib/run-gate.mjs'
import { launchBrowser } from '../../../scripts/lib/launch-browser.mjs'

cli({ url: import.meta.url, flags: { filter: 'eq', ...GATE_FLAGS } })

const CONF_DIR = dirname(dirname(fileURLToPath(import.meta.url)))
const ROOT = dirname(dirname(CONF_DIR))
const REACT_DIR = join(ROOT, 'packages', 'react')
const OUT_DIR = makeTempDir('.tmp-browser-url-reload-', CONF_DIR)
const FILTER = process.argv.slice(2).find((a) => a.startsWith('--filter='))?.slice('--filter='.length) ?? ''

// ---- the data server ------------------------------------------------------------------

/** The rows of `/d/<name>.json`: a few bars whose number and heights are a function of the name, and the next name to pick. */
function rowsOf(name: string): Array<{ x: number; y: number; next: string }> | null {
  if (name.startsWith('missing')) return null
  let h = 7
  for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) % 9973
  const n = 2 + (h % 4)
  const next = name === 'a' ? 'b' : name === 'b' ? 'c' : 'a'
  return Array.from({ length: n }, (_, i) => ({ x: 10 + i * 20, y: 10 + ((h + i * 37) % 40), next }))
}

const requests: string[] = []
let inFlight = 0
/** Milliseconds a response for a name is held, by name (a slow url). */
const SLOW: Record<string, number> = { slowb: 500 }
const server = createServer((req, res) => {
  const name = /^\/d\/(.+)\.json$/.exec(req.url ?? '')?.[1]
  const headers = { 'access-control-allow-origin': '*', 'content-type': 'application/json' }
  if (name === undefined) { res.writeHead(404, headers); res.end('{}'); return }
  requests.push(name)
  inFlight++
  setTimeout(() => {
    const rows = rowsOf(name)
    res.writeHead(rows ? 200 : 404, headers)
    res.end(JSON.stringify(rows ?? { error: 'missing' }))
    inFlight--
  }, SLOW[name] ?? 0)
})
await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve))
const ORIGIN = `http://127.0.0.1:${(server.address() as AddressInfo).port}`

// ---- cases ------------------------------------------------------------------------

type Step =
  | { t: 'select'; label: string }
  | { t: 'radio'; label: string }
  | { t: 'range'; value: string }
  | { t: 'click' }
  | { t: 'pair'; first: string; second: string; gapMs: number }

interface Case {
  name: string
  spec: Record<string, unknown>
  steps: Step[]
  /** Indices of the steps after which vega's picture must differ from before the step. */
  moves: number[]
  /**
   * A difference from vega that is Aster's choice, by the case's own words: the requests Aster makes, in order (vega's are what
   * the gate prints). The SVG must still equal vega's.
   */
  asterRequests?: string[]
  /** The case checks only that vega and Aster draw the same picture at the end of each step (the requests may differ: see `asterRequests`). */
  note?: string
}

const bars = (extra: Record<string, unknown> = {}): Record<string, unknown> => ({
  type: 'rect', from: { data: 'rows' }, encode: { update: {
    x: { field: 'x' }, y: { value: 5 }, width: { value: 12 }, height: { field: 'y' }, fill: { value: 'steelblue' },
    ...extra,
  } },
})
const frame = { width: 120, height: 80, padding: 6, autosize: 'none' }
const pick = (extra: Record<string, unknown> = {}): Record<string, unknown> => ({
  name: 'which', value: 'a', bind: { input: 'select', options: ['a', 'b', 'c'] }, ...extra,
})
const url = (expr: string): unknown => ({ signal: expr })

const CASES: Case[] = [
  {
    name: 'a bound select picks the url',
    spec: { ...frame, signals: [pick()], data: [{ name: 'rows', url: url("'/d/' + which + '.json'") }], marks: [bars()] },
    steps: [{ t: 'select', label: 'b' }, { t: 'select', label: 'c' }, { t: 'select', label: 'a' }, { t: 'select', label: 'b' }],
    moves: [0, 1, 2, 3],
  },
  {
    name: 'a bound radio group picks the url',
    spec: { ...frame, signals: [pick({ bind: { input: 'radio', options: ['a', 'b', 'c'] } })], data: [{ name: 'rows', url: url("'/d/' + which + '.json'") }], marks: [bars()] },
    steps: [{ t: 'radio', label: 'c' }, { t: 'radio', label: 'b' }],
    moves: [0, 1],
  },
  {
    name: 'a bound range builds the url',
    spec: {
      ...frame,
      signals: [{ name: 'n', value: 1, bind: { input: 'range', min: 1, max: 6, step: 1 } }],
      data: [{ name: 'rows', url: url("'/d/n' + n + '.json'") }], marks: [bars()],
    },
    steps: [{ t: 'range', value: '4' }, { t: 'range', value: '2' }, { t: 'range', value: '5' }],
    moves: [0, 1, 2],
  },
  {
    name: 'an event handler writes the signal the url reads',
    spec: {
      ...frame,
      signals: [{ name: 'which', value: 'a', on: [{ events: 'rect:click', update: 'datum.next' }] }],
      data: [{ name: 'rows', url: url("'/d/' + which + '.json'") }], marks: [bars()],
    },
    steps: [{ t: 'click' }, { t: 'click' }, { t: 'click' }],
    moves: [0, 1, 2],
  },
  {
    name: 'a signal derived from the bound one is the url',
    spec: {
      ...frame,
      signals: [pick(), { name: 'file', update: "'f-' + which" }],
      data: [{ name: 'rows', url: url("'/d/' + file + '.json'") }], marks: [bars()],
    },
    steps: [{ t: 'select', label: 'c' }, { t: 'select', label: 'b' }],
    moves: [0, 1],
  },
  {
    name: 'a signal the url does not read loads nothing (the bars follow it, the requests do not)',
    spec: {
      ...frame,
      signals: [pick(), { name: 'k', value: 1, bind: { input: 'range', min: 1, max: 3, step: 1 } }],
      data: [{ name: 'rows', url: url("'/d/' + which + '.json'") }], marks: [bars({ height: { signal: 'datum.y * k' } })],
    },
    steps: [{ t: 'range', value: '3' }, { t: 'select', label: 'b' }, { t: 'range', value: '2' }],
    moves: [0, 1, 2],
  },
  {
    name: 'a url dataset in a group reloads too',
    spec: {
      ...frame,
      signals: [pick()],
      marks: [{ type: 'group', data: [{ name: 'rows', url: url("'/d/' + which + '.json'") }], marks: [bars()] }],
    },
    steps: [{ t: 'select', label: 'b' }, { t: 'select', label: 'c' }],
    moves: [0, 1],
  },
  {
    // vega lets the superseded request finish and draws the LAST url's rows; Aster aborts it. Same picture, the requests may differ in
    // being cancelled (the server still saw them), so the requests compared are the ones issued.
    name: 'a url changed while the first still loads draws the last url\'s rows',
    spec: {
      ...frame,
      signals: [{ name: 'which', value: 'a', bind: { input: 'select', options: ['a', 'slowb', 'c'] } }],
      data: [{ name: 'rows', url: url("'/d/' + which + '.json'") }], marks: [bars()],
    },
    steps: [{ t: 'pair', first: 'slowb', second: 'c', gapMs: 50 }],
    moves: [0],
  },
]

// ---- the page --------------------------------------------------------------------

const entrySrc = `
import * as React from 'react'
import { createRoot } from 'react-dom/client'
import { flushSync } from 'react-dom'
import * as vega from 'vega'
import { Chart } from ${JSON.stringify(join(REACT_DIR, 'src/index.ts'))}

const host = document.createElement('div')
host.id = 'c'
host.style.cssText = 'position:absolute;left:20px;top:20px;width:400px'
document.body.appendChild(host)
const binds = document.createElement('div')
binds.style.cssText = 'position:absolute;left:20px;top:300px'
document.body.appendChild(binds)
window.__errors = []
let engine = null
let view = null
let root = null
const ref = React.createRef()
window.__mount = async (which, spec, origin) => {
  engine = which
  if (which === 'vega') {
    const log = { level() { return this }, error(...a) { window.__errors.push(a.map(String).join(' ')); return this }, warn(...a) { window.__errors.push(a.map(String).join(' ')); return this }, info() { return this }, debug() { return this } }
    view = new vega.View(vega.parse(spec), { loader: vega.loader({ baseURL: origin }), renderer: 'svg', container: host, bind: binds, hover: false, logger: log })
    await view.runAsync()
  } else {
    root = createRoot(host)
    flushSync(() => root.render(React.createElement(Chart, { ref, spec, urlLoad: { baseURL: origin }, onError: (e) => window.__errors.push(String(e.message)) })))
  }
}
window.__svg = async () => (engine === 'vega' ? await view.toSVG() : ref.current.getSvg().replace(/ data-datum="[^"]*"/g, ''))
window.__tick = () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)))
window.__ready = true
`

const drawnBy = (svg: string): string => svg

async function mountEngine(page: Page, engine: 'vega' | 'aster', spec: Record<string, unknown>): Promise<void> {
  await page.goto(`file://${join(OUT_DIR, 'index.html')}`)
  await page.waitForFunction(() => (window as unknown as { __ready?: boolean }).__ready === true, null, { timeout: 30_000 })
  await page.evaluate(([e, s, o]) => (window as unknown as { __mount: (...a: unknown[]) => Promise<void> }).__mount(e, s, o), [engine, spec, ORIGIN] as const)
}

/** Wait until the server has nothing in flight and has seen no new request for a while, and the page has painted. */
async function quiet(page: Page): Promise<void> {
  let last = -1
  let steady = 0
  for (let i = 0; i < 400 && steady < 4; i++) {
    await new Promise((r) => setTimeout(r, 25))
    if (inFlight === 0 && requests.length === last) steady++
    else steady = 0
    last = requests.length
  }
  await page.evaluate(() => (window as unknown as { __tick: () => Promise<void> }).__tick())
}

async function drive(page: Page, step: Step): Promise<void> {
  switch (step.t) {
    case 'select': await page.selectOption('select', { label: step.label }); break
    case 'radio': await page.locator('label', { hasText: new RegExp(`^\\s*${step.label}\\s*$`) }).locator('input[type=radio]').check(); break
    case 'range': await page.locator('input[type=range]').first().fill(step.value); break
    case 'click': await page.locator('svg .mark-rect path').first().click(); break
    case 'pair':
      await page.selectOption('select', { label: step.first })
      await new Promise((r) => setTimeout(r, step.gapMs))
      await page.selectOption('select', { label: step.second })
      break
  }
}

interface Run { svgs: string[]; requests: string[][]; errors: string[] }

async function run(browser: import('playwright').Browser, engine: 'vega' | 'aster', c: Case): Promise<Run> {
  const page = await browser.newPage({ deviceScaleFactor: 1, viewport: { width: 600, height: 500 } })
  const out: Run = { svgs: [], requests: [], errors: [] }
  try {
    page.on('pageerror', (e) => out.errors.push(`page error: ${e.message.slice(0, 300)}`))
    requests.length = 0
    await mountEngine(page, engine, c.spec)
    await quiet(page)
    const read = async (): Promise<void> => {
      out.svgs.push(await page.evaluate(() => (window as unknown as { __svg: () => Promise<string> }).__svg()))
      out.requests.push([...requests])
    }
    await read()
    for (const step of c.steps) {
      try { await drive(page, step) } catch (e) { throw new Error(`${engine}: step ${step.t} of "${c.name}": ${String(e).split('\n')[0]}; page: ${(await page.evaluate(() => document.body.innerHTML)).slice(0, 600)}`) }
      await quiet(page)
      await read()
    }
    out.errors.push(...(await page.evaluate(() => (window as unknown as { __errors: string[] }).__errors)).map((e) => `reported: ${e}`))
  } finally {
    await page.close()
  }
  return out
}

const canon = (svg: string): ReturnType<typeof canonicalizeSvg> => canonicalizeSvg(svg)

async function main(gate: Gate): Promise<void> {
  const playwright = await import('playwright')
  const browser = await launchBrowser(playwright.chromium, { headless: true, args: ['--disable-dev-shm-usage'] })
  try {
    const t0 = Date.now()
    let agree = 0
    const cases = CASES.filter((c) => !FILTER || c.name.includes(FILTER))
    for (const c of cases) {
      const vega = await run(browser, 'vega', c)
      const aster = await run(browser, 'aster', c)
      const problems: string[] = []
      for (const e of [...vega.errors, ...aster.errors]) if (e.startsWith('page error')) problems.push(e)
      if (vega.svgs.length !== aster.svgs.length) problems.push(`${vega.svgs.length} snapshots in vega, ${aster.svgs.length} in Aster`)
      for (let i = 0; i < Math.min(vega.svgs.length, aster.svgs.length); i++) {
        const label = i === 0 ? 'the mount' : `step ${i - 1} (${c.steps[i - 1]!.t})`
        const asterSvg = gate.plant ? aster.svgs[i]!.replace('</svg>', '<rect width="1" height="1"/></svg>') : aster.svgs[i]!
        const d = diffCanonical(canon(vega.svgs[i]!), canon(drawnBy(asterSvg)))
        if (d.length) problems.push(`${label}: the SVG differs from vega's: ${d.slice(0, 2).join('; ').slice(0, 240)}`)
        const vr = vega.requests[i]!.join(',')
        const ar = aster.requests[i]!.join(',')
        if (vr !== ar) problems.push(`${label}: requests, vega [${vr}] Aster [${ar}]`)
      }
      for (const i of c.moves) {
        if (vega.svgs[i] === vega.svgs[i + 1]) problems.push(`VACUOUS: step ${i} (${c.steps[i]!.t}) drew the same picture in vega`)
      }
      if (vega.requests.at(-1)!.length < 2) problems.push('VACUOUS: vega loaded at most one url')
      const reported = aster.errors.filter((e) => e.startsWith('reported'))
      if (reported.length) problems.push(`Aster reported ${reported.join(' | ').slice(0, 200)}`)
      if (problems.length) gate.differ(c.name, problems.slice(0, 5).join('\n      '))
      else { agree++; gate.agree(c.name) }
    }
    console.log(`\n[browser-url-reload] ${agree}/${cases.length} cases agree with real vega (${((Date.now() - t0) / 1000).toFixed(0)}s)`)
  } finally {
    await browser.close()
  }
}

await runGate({
  name: 'url-reload-browser',
  partial: Boolean(FILTER),
  counters: { compared: { floor: CASES.length, what: 'cases compared with real vega' } },
  run: async (gate) => {
    try {
      rmSync(OUT_DIR, { recursive: true, force: true })
      mkdirSync(OUT_DIR, { recursive: true })
      writeFileSync(join(OUT_DIR, 'page-entry.tsx'), entrySrc)
      await build({
        entryPoints: [join(OUT_DIR, 'page-entry.tsx')], bundle: true, format: 'iife', platform: 'browser', jsx: 'automatic', outfile: join(OUT_DIR, 'page.js'),
        define: { 'process.env.NODE_ENV': '"production"' }, nodePaths: [join(REACT_DIR, 'node_modules')], logLevel: 'silent', absWorkingDir: CONF_DIR,
      })
      writeFileSync(join(OUT_DIR, 'index.html'), '<!doctype html><html><body style="margin:0;width:600px;height:500px"><script src="./page.js"></script></body></html>')
      await main(gate)
    } finally {
      server.close()
      rmSync(OUT_DIR, { recursive: true, force: true })
    }
  },
})
