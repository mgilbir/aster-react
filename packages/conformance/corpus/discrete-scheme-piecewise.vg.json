{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 300,
  "height": 80,
  "padding": 5,
  "autosize": "pad",
  "background": "white",
  "data": [
    { "name": "table", "values": [
      { "v": 0 }, { "v": 1 }, { "v": 2 }, { "v": 3 }, { "v": 4 }, { "v": 5 },
      { "v": 6 }, { "v": 7 }, { "v": 8 }, { "v": 9 }, { "v": 10 }, { "v": 11 },
      { "v": 12 }, { "v": 13 }, { "v": 14 }, { "v": 15 }, { "v": 16 }, { "v": 17 },
      { "v": 18 }, { "v": 19 }
    ] }
  ],
  "scales": [
    { "name": "x", "type": "band", "domain": { "data": "table", "field": "v" }, "range": "width", "paddingInner": 0.1 },
    { "name": "c", "type": "linear", "domain": [0, 19], "range": { "scheme": "set1" }, "interpolate": "hcl" }
  ],
  "marks": [
    {
      "type": "rect",
      "from": { "data": "table" },
      "encode": {
        "update": {
          "x": { "scale": "x", "field": "v" },
          "width": { "scale": "x", "band": 1 },
          "y": { "value": 10 },
          "height": { "value": 50 },
          "fill": { "scale": "c", "field": "v" }
        }
      }
    }
  ]
}
