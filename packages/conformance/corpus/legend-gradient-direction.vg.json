{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": [
    { "name": "table", "values": [ { "a": "A", "b": 28 }, { "a": "B", "b": 55 }, { "a": "C", "b": 43 } ] }
  ],
  "scales": [
    { "name": "xscale", "type": "band", "domain": { "data": "table", "field": "a" }, "range": "width", "padding": 0.05 },
    { "name": "yscale", "type": "linear", "domain": { "data": "table", "field": "b" }, "nice": true, "range": "height" },
    { "name": "cs", "type": "linear", "domain": { "data": "table", "field": "b" }, "range": { "scheme": "viridis" } }
  ],
  "legends": [
    { "fill": "cs", "orient": "bottom", "title": "Values", "direction": "horizontal", "gradientLength": 120, "symbolType": "circle" }
  ],
  "axes": [ { "orient": "bottom", "scale": "xscale", "labels": false }, { "orient": "left", "scale": "yscale", "labels": false } ],
  "marks": [
    {
      "type": "rect", "from": { "data": "table" }, "encode": {
        "update": {
          "x": { "scale": "xscale", "field": "a" }, "width": { "scale": "xscale", "band": 1 },
          "y": { "scale": "yscale", "field": "b" }, "y2": { "scale": "yscale", "value": 0 },
          "fill": { "scale": "cs", "field": "b" }
        }
      }
    }
  ]
}
