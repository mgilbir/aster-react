{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "background": "white",
  "autosize": "none",
  "data": [
    { "name": "table", "values": [
      { "cat": "a", "val": 3 },
      { "cat": "b", "val": 7 },
      { "cat": "c", "val": 5 },
      { "cat": "d", "val": 9 }
    ]}
  ],
  "scales": [
    { "name": "x", "type": "band", "domain": { "data": "table", "field": "cat" }, "range": "width", "padding": 0.2 },
    { "name": "y", "type": "linear", "domain": { "data": "table", "field": "val" }, "range": [{ "signal": "height" }, 0], "nice": true }
  ],
  "axes": [
    { "scale": "x", "orient": "bottom", "grid": true, "labels": false },
    { "scale": "y", "orient": "left", "grid": true, "labels": false }
  ],
  "marks": [
    {
      "type": "rule",
      "from": { "data": "table" },
      "encode": {
        "update": {
          "x": { "scale": "x", "field": "cat", "offset": { "signal": "width / 2" } },
          "x2": { "scale": "x", "value": 0 },
          "y": { "scale": "y", "field": "val" },
          "stroke": { "value": "steelblue" },
          "strokeWidth": { "value": 3 }
        }
      }
    }
  ]
}
