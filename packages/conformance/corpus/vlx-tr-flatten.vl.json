{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "padding": 5,
  "autosize": "none",
  "width": 300,
  "height": 200,
  "data": {
    "name": "nested",
    "values": [
      {
        "k": "a",
        "xs": [
          1,
          2,
          3
        ],
        "ys": [
          4,
          5,
          6
        ]
      },
      {
        "k": "b",
        "xs": [
          2,
          3
        ],
        "ys": [
          7,
          8
        ]
      }
    ]
  },
  "transform": [
    {
      "flatten": [
        "xs",
        "ys"
      ],
      "as": [
        "x1",
        "y1"
      ]
    }
  ],
  "mark": "point",
  "encoding": {
    "x": {
      "field": "x1",
      "type": "quantitative"
    },
    "y": {
      "field": "y1",
      "type": "quantitative"
    },
    "color": {
      "field": "k",
      "type": "nominal"
    }
  }
}
