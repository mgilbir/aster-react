{"$schema": "https://vega.github.io/schema/vega/v6.json", "width": 200, "height": 100, "padding": 5, "autosize": "none", "signals": [{"name": "mu", "init": "quantileUniform(0.5, 10, 20)"}], "data": [{"name": "t", "values": [{"v": -1}, {"v": 0}, {"v": 0.5}, {"v": 2}], "transform": [{"type": "filter", "expr": "densityNormal(datum.v, 0, 1) > 0.05"}, {"type": "formula", "expr": "cumulativeLogNormal(abs(datum.v) + 1, 0, 1)", "as": "c"}]}], "marks": [{"type": "rect", "from": {"data": "t"}, "encode": {"update": {"x": {"signal": "datum.v * 20 + 40"}, "y": {"value": 10}, "width": {"value": 10}, "height": {"signal": "datum.c * 60"}, "fill": [{"test": "cumulativeUniform(datum.v, -2, 3) > 0.5", "value": "steelblue"}, {"signal": "mu > 14 ? 'orange' : 'gray'"}]}}}]}