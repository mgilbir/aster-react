{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "projections": [
    { "name": "proj", "type": "mercator", "scale": 200, "translate": { "signal": "[width / 2, height / 2]" } }
  ],
  "data": [
    { "name": "geo", "values": [
      { "type": "Polygon", "coordinates": [ [ [ -10, -10 ], [ 10, -10 ], [ 10, 10 ], [ -10, 10 ], [ -10, -10 ] ] ] },
      { "type": "Polygon", "coordinates": [ [ [ 20, 20 ], [ 40, 20 ], [ 40, 40 ], [ 20, 40 ], [ 20, 20 ] ] ] }
    ] }
  ],
  "marks": [
    {
      "type": "shape", "from": { "data": "geo" },
      "transform": [ { "type": "geoshape", "projection": "proj" } ],
      "encode": { "update": { "fill": { "value": "steelblue" }, "stroke": { "value": "white" } } }
    }
  ]
}
