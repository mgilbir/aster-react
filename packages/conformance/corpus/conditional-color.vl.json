{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 400, "height": 300, "padding": 5, "autosize": "none",
  "data": { "name": "table", "values": [
    { "x": 1, "y": 2, "val": 5 }, { "x": 2, "y": 4, "val": 15 },
    { "x": 3, "y": 3, "val": 8 }, { "x": 4, "y": 5, "val": 20 }
  ]},
  "mark": "point",
  "encoding": {
    "x": { "field": "x", "type": "quantitative" },
    "y": { "field": "y", "type": "quantitative" },
    "color": {
      "condition": { "test": "datum.val > 10", "value": "red" },
      "value": "steelblue"
    }
  }
}
