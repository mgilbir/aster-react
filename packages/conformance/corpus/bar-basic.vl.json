{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": { "name": "table", "values": [{ "x": "a", "y": 1 }, { "x": "b", "y": 3 }, { "x": "c", "y": 2 }] },
