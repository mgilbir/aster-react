{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "padding": 5,
  "autosize": "none",
  "width": 400,
  "height": 260,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "graticule": {
      "extent": [
