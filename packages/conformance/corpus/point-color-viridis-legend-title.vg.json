{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": [
    {
      "name": "table",
      "values": [
        {"x": 1, "y": 2, "val": 10},
        {"x": 2, "y": 4, "val": 50},
        {"x": 3, "y": 3, "val": 90}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"data": "table", "field": "x"},
      "range": "width",
      "nice": true
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"data": "table", "field": "y"},
      "range": [{"signal": "height"}, 0],
      "nice": true
    },
    {
      "name": "color",
      "type": "sequential",
      "domain": {"data": "table", "field": "val"},
      "scheme": "viridis"
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "size": {"value": 200},
          "fill": {"scale": "color", "field": "val"}
        }
      }
    }
  ],
  "axes": [
    {"scale": "x", "orient": "bottom", "grid": true, "labels": false},
    {"scale": "y", "orient": "left", "grid": true, "labels": false}
  ],
  "legends": [
    {"fill": "color", "title": "Temperature"}
  ]
}
