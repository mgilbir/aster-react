{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "padding": 5,
  "autosize": "none",
  "width": 420,
  "height": 280,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "steelblue",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "black"
      }
    }
  ]
}
