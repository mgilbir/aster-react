{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": [
    { "name": "table", "values": [
      { "a": "A", "b": 28 }, { "a": "B", "b": 55 }, { "a": "C", "b": 43 }, { "a": "D", "b": 91 }, { "a": "E", "b": 19 }
    ] }
  ],
  "scales": [
    { "name": "xscale", "type": "band", "domain": { "data": "table", "field": "a" }, "range": "width", "padding": 0.1 },
    { "name": "yscale", "type": "linear", "domain": { "data": "table", "field": "b" }, "nice": true, "range": "height" }
  ],
  "axes": [ { "orient": "bottom", "scale": "xscale", "labels": false } ],
  "marks": [
    {
      "type": "rect", "from": { "data": "table" }, "encode": {
        "update": {
          "x": { "scale": "xscale", "field": "a" }, "width": { "scale": "xscale", "band": 1 },
          "y": { "scale": "yscale", "field": "b" }, "y2": { "scale": "yscale", "value": 0 },
          "cornerRadius": { "value": 5 },
          "fill": { "value": "steelblue" }
        }
      }
    }
  ]
}
