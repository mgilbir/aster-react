{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": [
    {
      "name": "table",
      "values": [
        {"x": 0, "y": 10, "c": "#4c78a8"},
        {"x": 1, "y": 20, "c": "#f58518"},
        {"x": 2, "y": 15, "c": "#e45756"}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"data": "table", "field": "x"},
      "range": "width",
      "nice": true
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"data": "table", "field": "y"},
      "range": [{"signal": "height"}, 0],
      "nice": true
    }
  ],
  "marks": [
    {
      "type": "line",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "stroke": {"field": "c"},
          "strokeWidth": {"value": 2}
        }
      }
    }
  ],
  "axes": [
    {"scale": "x", "orient": "bottom", "grid": true, "labels": false},
    {"scale": "y", "orient": "left", "grid": true, "labels": false}
  ]
}
