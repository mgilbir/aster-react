{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": [
    { "name": "table", "values": [ { "a": "A", "b": 28 }, { "a": "B", "b": 55 }, { "a": "C", "b": 43 } ] }
  ],
  "scales": [
    { "name": "xscale", "type": "band", "domain": { "data": "table", "field": "a" }, "range": "width", "padding": 0.05 },
    { "name": "yscale", "type": "linear", "domain": { "data": "table", "field": "b" }, "nice": true, "range": "height" }
  ],
  "axes": [ { "orient": "bottom", "scale": "xscale", "labels": false } ],
  "marks": [
    {
      "type": "rect", "from": { "data": "table" }, "encode": {
        "update": {
          "x": { "scale": "xscale", "field": "a" }, "width": { "scale": "xscale", "band": 1 },
          "y": { "scale": "yscale", "field": "b" }, "y2": { "scale": "yscale", "value": 0 },
          "fill": { "signal": "test(datum.b > 50, rgb('#4c78a8'), hsl(120, 1, 0.5))" }
        }
      }
    },
    {
      "type": "text", "from": { "data": "table" }, "encode": {
        "update": {
          "x": { "signal": "clamp(scale('xscale', datum.a) + bandwidth('xscale') / 2, 0, width)" },
          "y": { "signal": "invert('yscale', 150)" },
          "text": { "signal": "truncate(upper(datum.a) + ' ' + domain('yscale')[0] + '-' + domain('yscale')[1], 8, 'center', '…')" },
          "align": { "value": "center" }, "fill": { "value": "black" }
        }
      }
    }
  ]
}
