{"$schema": "https://vega.github.io/schema/vega/v6.json", "padding": 5, "autosize": "none", "width": 200, "height": 100, "data": [{"name": "seq", "transform": [{"type": "sequence", "start": {"signal": "ext[0]"}, "stop": {"signal": "ext[1] + 1"}, "step": 1, "as": "v"}]}, {"name": "base", "values": [{"x": 3}, {"x": 9}, {"x": 5}], "transform": [{"type": "extent", "field": "x", "signal": "ext"}]}, {"name": "late", "source": "seq", "transform": [{"type": "formula", "as": "w", "expr": "datum.v * span"}]}], "signals": [{"name": "span", "update": "ext[1] - ext[0]"}], "scales": [{"name": "x", "type": "linear", "domain": {"data": "late", "field": "w"}, "range": "width"}], "marks": [{"type": "rect", "from": {"data": "late"}, "encode": {"update": {"x": {"scale": "x", "field": "w"}, "width": {"value": 5}, "y": {"value": 10}, "height": {"value": 10}, "fill": {"value": "red"}}}}]}