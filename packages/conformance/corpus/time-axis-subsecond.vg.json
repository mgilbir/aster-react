{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 200,
  "height": 120,
  "padding": 5,
  "background": "white",
  "autosize": "none",
  "data": [
    {
      "name": "table",
      "values": [
        { "k": "a", "t": 1 },
        { "k": "b", "t": 2 },
        { "k": "c", "t": 3 },
        { "k": "d", "t": 4 }
      ]
    }
  ],
  "scales": [
    { "name": "x", "type": "band", "domain": { "data": "table", "field": "k" }, "range": "width", "padding": 0.1 },
    { "name": "y", "type": "time", "domain": { "data": "table", "field": "t" }, "range": "height" }
  ],
  "axes": [
    { "orient": "bottom", "scale": "x" },
    { "orient": "left", "scale": "y", "tickCount": 4, "grid": true }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": { "data": "table" },
      "encode": {
        "enter": {
          "x": { "scale": "x", "field": "k", "band": 0.5 },
          "y": { "scale": "y", "field": "t" },
          "size": { "value": 50 }
        }
      }
    }
  ]
}
