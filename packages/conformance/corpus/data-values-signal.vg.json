{"$schema": "https://vega.github.io/schema/vega/v6.json", "padding": 5, "autosize": "none", "width": 200, "height": 100, "signals": [{"name": "rows", "value": [{"a": 1}, {"a": 3}, {"a": 2}]}, {"name": "scaleBy", "update": "rows[1].a * 20"}], "data": [{"name": "t", "values": {"signal": "rows"}}, {"name": "u", "source": "t", "transform": [{"type": "formula", "as": "b", "expr": "datum.a * scaleBy"}]}], "scales": [{"name": "x", "type": "linear", "domain": {"data": "u", "field": "b"}, "range": "width"}], "marks": [{"type": "rect", "from": {"data": "u"}, "encode": {"update": {"x": {"scale": "x", "field": "b"}, "width": {"value": 10}, "y": {"signal": "10 + 15 * datum.a"}, "height": {"value": 10}, "fill": {"value": "red"}}}}]}