{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "autosize": "none",
  "data": [
    {
      "name": "table",
      "values": [
        {"cat":"A","group":"X","val":3},
        {"cat":"A","group":"Y","val":5},
        {"cat":"B","group":"X","val":4},
        {"cat":"B","group":"Y","val":2}
      ]
    }
  ],
  "scales": [
    {"name":"x","type":"band","domain":{"data":"table","field":"cat","sort":true},"range":"width","paddingInner":0.2},
    {"name":"y","type":"linear","domain":{"data":"table","field":"val"},"range":[{"signal":"height"},0],"zero":true,"nice":true},
    {"name":"xo","type":"band","domain":{"data":"table","field":"group","sort":true},"range":[0,{"signal":"bandwidth('x')"}]}
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "table"},
      "encode": {
        "update": {
          "x": {"signal": "scale('x',datum.cat)+scale('xo',datum.group)"},
          "width": {"scale": "xo", "band": 1},
          "y": {"scale": "y", "field": "val"},
          "y2": {"scale": "y", "value": 0},
          "fill": {"value": "steelblue"}
        }
      }
    }
  ],
  "axes": [
    {"scale": "x", "orient": "bottom", "grid": true, "labels": false},
    {"scale": "y", "orient": "left", "grid": true, "labels": false}
  ]
}
