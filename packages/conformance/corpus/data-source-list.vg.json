{"$schema": "https://vega.github.io/schema/vega/v6.json", "padding": 5, "autosize": "none", "width": 200, "height": 120, "data": [{"name": "a", "values": [{"k": 1}, {"k": 2}]}, {"name": "b", "values": [{"k": 3}, {"k": 4}]}, {"name": "c", "source": ["b", "a"]}, {"name": "d", "source": ["a", "b"], "transform": [{"type": "filter", "expr": "datum.k != 2"}]}, {"name": "e", "source": ["a"], "transform": [{"type": "formula", "as": "z", "expr": "datum.k*2"}]}, {"name": "all", "source": ["d", "e", "a"], "transform": [{"type": "identifier", "as": "i0"}]}], "scales": [{"name": "x", "type": "linear", "domain": [0, 10], "range": "width"}], "marks": [{"type": "symbol", "from": {"data": "all"}, "encode": {"update": {"x": {"scale": "x", "field": "k"}, "y": {"signal": "10 + 14 * datum.i0"}, "size": {"value": 60}, "fill": {"signal": "datum.z ? 'tomato' : 'steelblue'"}}}}, {"type": "text", "from": {"data": "c"}, "encode": {"update": {"x": {"value": 150}, "y": {"signal": "20 + 12 * indexof(pluck(data('c'), 'k'), datum.k)"}, "text": {"field": "k"}}}}]}