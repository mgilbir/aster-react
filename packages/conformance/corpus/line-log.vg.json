{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400,
  "height": 300,
  "padding": 5,
  "background": "white",
  "autosize": "none",
  "data": [
    { "name": "table", "values": [
      { "x": 1, "y": 10 },
      { "x": 2, "y": 20 },
      { "x": 4, "y": 15 },
      { "x": 8, "y": 40 },
      { "x": 16, "y": 30 }
    ]}
  ],
  "scales": [
    { "name": "x", "type": "linear", "domain": { "data": "table", "field": "x" }, "range": "width", "nice": true },
    { "name": "y", "type": "log", "domain": { "data": "table", "field": "y" }, "range": [{ "signal": "height" }, 0], "nice": true }
  ],
  "axes": [
    { "scale": "x", "orient": "bottom", "grid": true, "labels": false },
    { "scale": "y", "orient": "left", "grid": true, "labels": false }
  ],
  "marks": [
    {
      "type": "line",
      "from": { "data": "table" },
      "encode": {
        "update": {
          "x": { "scale": "x", "field": "x" },
          "y": { "scale": "y", "field": "y" },
          "stroke": { "value": "steelblue" },
          "strokeWidth": { "value": 2 }
        }
      }
    }
  ]
}
