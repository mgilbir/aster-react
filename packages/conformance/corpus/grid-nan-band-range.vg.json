{
 "$schema": "https://vega.github.io/schema/vega/v6.json",
 "width": 200,
 "height": 120,
 "padding": 5,
 "autosize": "none",
 "background": "white",
 "scales": [
  {
   "name": "x",
   "type": "band",
   "domain": [
    "a",
    "b",
    "c"
   ],
   "range": "symbol"
  },
  {
   "name": "y",
   "type": "linear",
   "domain": [
    0,
    10
   ],
   "range": "height"
  }
 ],
 "axes": [
  {
   "scale": "y",
   "orient": "left",
   "grid": true,
   "gridScale": "x"
  },
  {
   "scale": "x",
   "orient": "bottom"
  }
 ]
}
