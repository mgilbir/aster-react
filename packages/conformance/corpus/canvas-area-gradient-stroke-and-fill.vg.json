{
 "$schema": "https://vega.github.io/schema/vega/v6.json",
 "width": 300,
 "height": 200,
 "padding": 5,
 "autosize": "none",
 "background": "white",
 "data": [
  {
   "name": "table",
   "values": [
    {
     "x": 0,
     "y": 10
    },
    {
     "x": 1,
     "y": 20
    },
    {
     "x": 2,
     "y": 15
    },
    {
     "x": 3,
     "y": 25
    },
    {
     "x": 4,
     "y": 12
    }
   ]
  }
 ],
 "scales": [
  {
   "name": "x",
   "type": "linear",
   "domain": [
    0,
    4
   ],
   "range": "width"
  },
  {
   "name": "y",
   "type": "linear",
   "domain": [
    0,
    30
   ],
   "range": [
    {
     "signal": "height"
    },
    0
   ]
  }
 ],
 "marks": [
  {
   "type": "area",
   "from": {
    "data": "table"
   },
   "encode": {
    "update": {
     "x": {
      "scale": "x",
      "field": "x"
     },
     "y": {
      "scale": "y",
      "field": "y"
     },
     "y2": {
      "scale": "y",
      "value": 0
     },
     "fill": {
      "value": {
       "gradient": "linear",
       "stops": [
        {
         "offset": 0,
         "color": "#08306b"
        },
        {
         "offset": 1,
         "color": "#f7fbff"
        }
       ],
       "x1": 0,
       "y1": 0,
       "x2": 0,
       "y2": 1
      }
     },
     "stroke": {
      "value": {
       "gradient": "linear",
       "stops": [
        {
         "offset": 0,
         "color": "red"
        },
        {
         "offset": 1,
         "color": "blue"
        }
       ],
       "x1": 0,
       "y1": 0,
       "x2": 1,
       "y2": 0
      }
     },
     "strokeWidth": {
      "value": 3
     }
    }
   }
  }
 ]
}
